module examples.Hello where

{-
    A tiny Frege program.
-}
import frege.java.Util (List)

data Shape = Circle Double | Square Double

-- Compute the area of a shape.
area :: Shape -> Double
area (Circle r) = pi * r * r
area (Square s) = s * s

main _ = println (area (Circle 2.0))
