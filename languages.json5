	"RPM Spec": {
		file_patterns: ["*.spec"],
		line_comments: ["#"],
		// Erlang's common_test specs, PyInstaller's and generated files share `.spec`, so a file has to show an RPM section or tag.
		keywords: {words: ["%description", "%prep", "%build", "%install", "%files", "%changelog", "BuildRequires:", "%global "], required: "always"},
	},
	"Ruby": {
		file_patterns: ["*.rb", "*.builder", "*.eye", "*.gemspec", "*.god", "*.jbuilder", "*.mspec", "*.pluginspec", "*.podspec", "*.rabl", "*.rake", "*.rbuild", "*.rbw", "*.rbx", "*.ruby", "*.thor", "*.watchr", ".irbrc", ".pryrc", "Appraisals", "Berksfile", "Brewfile", "Buildfile", "Capfile", "Dangerfile", "Deliverfile", "Fastfile", "Gemfile", "Guardfile", "Jarfile", "Mavenfile", "Podfile", "Puppetfile", "Rakefile", "Snapfile", "Thorfile", "rakefile", "*.ru", "Vagrantfile", "*.rbi", "*.rbs", "*.jb", "*.rjs", "*.irb", "*.prawn"],
		line_comments: ["#"],
		block_comments: [["=begin", "=end"]],
		shebangs: ["#!/usr/bin/ruby", "#!/usr/bin/env ruby"],
		strings: [{open: "\"", interpolation: "#{"}, "'"],
		heredoc: "ruby",
	},
