// Language definitions, compiled into codestats by build.rs. Entries must stay in alphabetical order.
//
// Fields:
//   file_patterns        Required. Exact filenames (`Makefile`, matched case-sensitively), extensions (`*.rs`, matched
//                        case-insensitively), or other globs (`Kconfig.*`). When patterns from several languages match a
//                        file, only the most specific ones count: exact filenames beat globs, and `*.blade.php` beats `*.php`.
//   line_comments        Markers that start a comment running to the end of the line. Markers made of letters (`REM`)
//                        must be followed by a non-letter.
//   block_comments       [start, end] pairs. A comment only closes with the end of the pair that opened it.
//   nested_blocks        `true` if all block comments nest, or a list of the start markers that do (D: ["/+"]).
//   column_one_comments  Markers that only count in the first column, like fixed-form Fortran's `C`.
//   shebangs             Shebang prefixes that identify the language for files without a known extension.
//   keywords             Used to choose between languages that share a pattern; every language sharing a pattern needs
//                        some. Words match whole tokens case-insensitively; anything with punctuation (`@interface`,
//                        `:=`) matches as text. On a tie, a language whose keywords aren't required wins, then the one
//                        with fewer keywords, so a language that extends another should list the base language's
//                        keywords plus its own. When all the languages sharing a pattern write comments the same way,
//                        keywords inside comments don't count. A list of words, or the full form
//                        {words, required, case_sensitive}:
//                          required: "shared" only picks the language, where its pattern is shared, when a keyword
//                            matches that not every other language sharing it has (junk-drawer extensions like `.inc`,
//                            and C++ in a `.h`); when nothing matches, the sharing language without required keywords is
//                            the default. "always" holds the language to that even for a pattern only it has, for one
//                            that other files often use too (RPM Spec's `.spec`), which are then left uncounted.
//                          case_sensitive: word keywords only match in the case they're written (C's `virtual`, but
//                            not `VIRTUAL`).
//   shebang_overrides    A file with this language's extension that starts with a shebang is the shebang's language
//                        (BRLTTY runs contraction tables that are programs, like a `.ctb` Python script).
//   strings              String literals, so comment markers inside them are ignored and their contents count as code.
//                        `"\""` is a one-line string with a `\` escape. The full form is
//                        {open, close (defaults to open), escape (`null` for raw strings, or the quote itself for
//                        doubled quotes like 'it''s'), multiline, char, doc, delimited, attribute}. `char` only
//                        opens a string when it looks like a char literal (so Rust's `'a` lifetimes stay code). `doc`
//                        makes a string that starts a line count as a comment, like Python docstrings. `delimited`
//                        puts a delimiter of the writer's choosing between the opener and a `(`, and the string ends
//                        at `)`, that delimiter and the close, like C++'s `R"xy(...)xy"`. `attribute` strings only
//                        open right after an `=`, as HTML attribute values do, so an apostrophe in text opens nothing.
//                        `interpolation` names what opens a hole of code in the string (`${`, `#{`, C#'s `{`, Swift's
//                        `\(`), which runs to the bracket matching the opener's last one; strings and comments in it
//                        are read as code's. A doubled one-character opener, like C#'s `{{`, is text.
//   c_preprocessor       The file goes through the C preprocessor although `#` also starts comments (assembly `.S`
//                        files), so directives like `# define` or `# if defined(X)` count as code.
//   regex_literals       `/.../` regex literals (JavaScript), so quotes or `/*` inside them are ignored. A `/` starts a
//                        regex after an operator, opening bracket or keyword like `return`; otherwise it's division.
//   line_block_comments  Block comments whose markers only count at the start of a line, with no indentation before
//                        them (Perl's POD, from `=pod` to `=cut`), so an indented `=cut` in the documentation is text.
//   line_blocks_alone    The line block comments' markers also have to be alone on their line, spaces aside (MATLAB's
//                        `%{` and `%}`), so `%{ note` is an ordinary comment.
//   line_splices         A backslash ending a line joins it to the next, as in C, so a line comment ending in one
//                        carries on onto the next line.
//   heredoc              The language's heredocs, whose body runs from the next line to the line holding just the
//                        terminator named after the opener: "shell" (`<<EOF`, `<< 'EOF'`), "perl" (`<<EOF`, `<< "EOF"`),
//                        "ruby" (`<<~EOF`, with no space, as `x << y` appends) or "php" (`<<<EOT`).
//   embedding            Regions written in other languages, counted by those languages' rules: "html" (`<script>`
//                        and `<style>` elements), "astro" (those plus a TypeScript frontmatter), "markdown" (fenced
//                        code blocks, and YAML or TOML frontmatter), "asciidoc" (`[source,python]` blocks and fenced
//                        code blocks), "org" (`#+BEGIN_SRC python` blocks), "restructuredtext" (`.. code-block::`
//                        directives) or "php" (the HTML outside `<?php ... ?>` tags, with its own elements).
{
	"1C Enterprise": {
		file_patterns: ["*.bsl", "*.os"],
		line_comments: ["//"],
	},
	"4D": {
		file_patterns: ["*.4dm"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		strings: ["\""],
	},
	"8th": {
		file_patterns: ["*.8th"],
		line_comments: ["\\"],
		block_comments: [["(*", "*)"]],
		nested_blocks: true,
	},
	"ABAP": {
		file_patterns: ["*.abap"],
		line_comments: ["*", "\""],
	},
	"ABAP CDS": {
		file_patterns: ["*.asddls"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
	"ABNF": {
		file_patterns: ["*.abnf"],
		line_comments: [";"],
	},
	"ACPI Source Language": {
		file_patterns: ["*.asl"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		strings: ["\""],
	},
	"ActionScript": {
		file_patterns: ["*.as"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		keywords: ["package", "import", "function", "var", "flash.display", "Vector.<"],
	},
	"Ada": {
		file_patterns: ["*.ada", "*.adb", "*.ads", "*.pad"],
		line_comments: ["--"],
		keywords: ["procedure", "function", "package", "with", "use", "begin", "end", "is", "record"],
	},
	"AFL": {
		file_patterns: ["*.afl"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
	"Agda": {
		file_patterns: ["*.agda", "*.lagda"],
		line_comments: ["--"],
		block_comments: [["{-", "-}"]],
		nested_blocks: true,
	},
	"Agena": {
		file_patterns: ["*.agn"],
		line_comments: ["#"],
		block_comments: [["#/", "/#"], ["/*", "*/"]],
		strings: ["\""],
	},
	"AGS Script": {
		file_patterns: ["*.ash"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		strings: ["\""],
	},
	"Aiken": {
		file_patterns: ["*.ak"],
		line_comments: ["//"],
	},
	"Alchemist": {
		file_patterns: ["*.crn"],
		line_comments: ["#"],
	},
	"Aleo": {
		file_patterns: ["*.aleo"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		strings: ["\""],
	},
	"Alex": {
		file_patterns: ["*.x"],
		keywords: ["%wrapper", "$white", "@string"],
		line_comments: ["--"],
		block_comments: [["{-", "-}"]],
		nested_blocks: true,
	},
	"Algol 68": {
		file_patterns: ["*.a68"],
		block_comments: [["#", "#"], ["CO", "CO"], ["COMMENT", "COMMENT"]],
	},
	"Alloy": {
		file_patterns: ["*.als"],
		line_comments: ["//", "--"],
		block_comments: [["/*", "*/"]],
	},
	"Amber": {
		file_patterns: ["*.ab"],
		line_comments: ["//"],
		strings: ["\""],
	},
	"AMPL": {
		file_patterns: ["*.ampl", "*.mod"],
		line_comments: ["#"],
		block_comments: [["/*", "*/"]],
		keywords: ["param", "var", "subject to", "minimize", "maximize", "set"],
	},
	"Android Interface Definition Language": {
		file_patterns: ["*.aidl"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
	"AngelScript": {
		file_patterns: ["*.as", "*.angelscript"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		keywords: ["funcdef", "shared", "mixin", "dictionary", "array<", "uint8", "int64"],
	},
	"ANTLR": {
		file_patterns: ["*.g4"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
	"Apache Config": {
		file_patterns: [".htaccess", "httpd.conf", "apache2.conf"],
		line_comments: ["#"],
	},
	"Apex": {
		file_patterns: ["*.apex", "*.apexcls", "*.trigger", "*.cls"],
		keywords: {words: ["System.debug", "@isTest", "public class", "global class", "with sharing", "private class", "@AuraEnabled"], required: "shared"},
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
	"APL": {
		file_patterns: ["*.apl", "*.aplf", "*.apls", "*.apla", "*.aplc", "*.apli", "*.apln", "*.aplo", "*.dyalog", "*.dyapp", "*.mipage"],
		line_comments: ["⍝"],
	},
	"Apollo Guidance Computer": {
		file_patterns: ["*.agc"],
		line_comments: ["#"],
	},
	"AppleScript": {
		file_patterns: ["*.applescript"],
		line_comments: ["--", "#"],
		block_comments: [["(*", "*)"]],
		shebangs: ["#!/usr/bin/env osascript", "#!/usr/bin/osascript"],
	},
	"Arc": {
		file_patterns: ["*.arc"],
		line_comments: [";"],
	},
	"ArkScript": {
		file_patterns: ["*.ark"],
		line_comments: ["#"],
		strings: ["\""],
	},
	"ArkTs": {
		file_patterns: ["*.ets"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
	"Arturo": {
		file_patterns: ["*.art"],
		line_comments: [";"],
	},
	"AsciiDoc": {
		file_patterns: ["*.adoc", "*.asciidoc"],
		line_comments: ["//"],
		block_comments: [["////", "////"]],
		embedding: "asciidoc",
	},
	"ASN.1": {
		file_patterns: ["*.asn1", "*.asn"],
		line_comments: ["--"],
		block_comments: [["/*", "*/"]],
	},
	"ASP": {
		file_patterns: ["*.asp", "*.asa"],
		line_comments: ["'", "rem", "REM", "Rem"],
	},
	"ASP.NET": {
		file_patterns: ["*.asax", "*.ascx", "*.asmx", "*.aspx", "*.master", "*.sitemap", "*.webinfo", "*.ashx"],
		block_comments: [["<!--", "-->"], ["<%--", "--%>"]],
		embedding: "html",
	},
	"AspectJ": {
		file_patterns: ["*.aj"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
	"Assembly": {
		file_patterns: ["*.asm", "*.s", "*.S", "*.inc", "*.s65", "*.a65", "*.a51"],
		line_comments: [";", "# ", "#\t", "//"],
		block_comments: [["/*", "*/"]],
		keywords: {words: ["%macro", "%endmacro", "%define", "%include", "%ifdef", "section ."], required: "shared"},
		c_preprocessor: true,
	},
	"Astro": {
		file_patterns: ["*.astro"],
		block_comments: [["/*", "*/"], ["<!--", "-->"]],
		embedding: "astro",
	},
	"Asymptote": {
		file_patterns: ["*.asy"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		strings: ["\""],
	},
	"Ats": {
		file_patterns: ["*.dats", "*.hats", "*.sats", "*.atxt", "*.ats"],
		line_comments: ["//"],
		block_comments: [["(*", "*)"], ["/*", "*/"]],
	},
	"Augeas": {
		file_patterns: ["*.aug"],
		block_comments: [["(*", "*)"]],
		nested_blocks: true,
	},
	"Austral": {
		file_patterns: ["*.aum", "*.aui"],
		line_comments: ["--"],
		block_comments: [["(*", "*)"]],
	},
	"AutoHotkey": {
		file_patterns: ["*.ahk", "*.ahkl", "*.ah2", "*.ah1"],
		line_comments: [";"],
		block_comments: [["/*", "*/"]],
	},
	"AutoIt": {
		file_patterns: ["*.au3"],
		line_comments: [";"],
		block_comments: [["#comments-start", "#comments-end"], ["#cs", "#ce"]],
	},
	"Automake": {
		file_patterns: ["*.am"],
		line_comments: ["#"],
	},
	"AviSynth": {
		file_patterns: ["*.avs", "*.avsi"],
		line_comments: ["#"],
		block_comments: [["/*", "*/"], ["[*", "*]"]],
		strings: ["\""],
	},
	"Avro": {
		file_patterns: ["*.avsc", "*.avdl", "*.avpr"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
	"AWK": {
		file_patterns: ["*.awk", "*.gawk", "*.nawk", "*.mawk", "*.auk"],
		line_comments: ["#"],
		shebangs: ["#!/bin/awk -f", "#!/usr/bin/awk -f", "#!/usr/bin/env awk", "#!/usr/bin/env gawk"],
	},
	"AXAML": {
		file_patterns: ["*.axaml"],
		block_comments: [["<!--", "-->"]],
	},
	"B": {
		file_patterns: ["*.b"],
		block_comments: [["/*", "*/"]],
		keywords: ["auto", "break", "case", "default", "do", "else", "extern", "extrn", "for", "goto", "if", "main", "read", "return", "static", "switch", "while", "write"],
	},
	"Ballerina": {
		file_patterns: ["*.bal"],
		line_comments: ["//", "#"],
	},
	"BAML": {
		file_patterns: ["*.baml"],
		line_comments: ["//"],
		block_comments: [["{//", "//}"]],
		strings: ["\""],
	},
	"Bash": {
		file_patterns: ["*.bash", "*.sh", ".profile", ".bash_logout", ".bash_profile", ".bashrc", ".bash_aliases", ".bash_login", "*.bats", "*.dash", "*.mksh", "*.sbatch", "*.slurm", "*.command", "*.sh.in", "APKBUILD", "*.exheres-0", "*.exlib", "*.pacscript"],
		line_comments: ["#"],
		shebangs: ["#!/bin/bash", "#!/usr/bin/env bash", "#!/bin/sh", "#!/usr/bin/env sh", "#!/bin/dash", "#!/usr/bin/env dash"],
		strings: [{open: "\"", multiline: true}, {open: "'", escape: null, multiline: true}],
		heredoc: "shell",
	},
	"Batch": {
		file_patterns: ["*.bat", "*.cmd", "*.btm"],
		line_comments: ["rem", "::", "REM", "Rem", "@rem", "@REM"],
	},
	"Bazel": {
		file_patterns: ["*.bzl", "*.bazel", "BUILD", "BUILD.bazel", "WORKSPACE", "WORKSPACE.bazel", "MODULE.bazel"],
		line_comments: ["#"],
	},
	"BBCode": {
		file_patterns: ["*.bbcode"],
	},
	"bc": {
		file_patterns: ["*.bc"],
		line_comments: ["#"],
		block_comments: [["/*", "*/"]],
		strings: ["\""],
	},
	"BCPL": {
		file_patterns: ["*.bcpl"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
	"BCX/FreeBASIC": {
		file_patterns: ["*.bas", "*.bi"],
		line_comments: ["'", "rem", "REM", "Rem"],
		block_comments: [["$comment", "$comment"], ["/'", "'/"]],
	},
	"Bean": {
		file_patterns: ["*.bean", "*.beancount"],
		line_comments: [";"],
	},
	"Beef": {
		file_patterns: ["*.beef", "*.bf"],
		keywords: {words: ["namespace", "using System", "public class", "static void"], required: "shared"},
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
	"Befunge": {
		file_patterns: ["*.befunge", "*.b93", "*.b98"],
	},
	"Bend": {
		file_patterns: ["*.bend"],
		line_comments: ["//", "#"],
	},
	"Berry": {
		file_patterns: ["*.be"],
		line_comments: ["#"],
		block_comments: [["#-", "-#"]],
		strings: ["\""],
	},
	"BGT": {
		file_patterns: ["*.bgt"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
	"BibTeX": {
		file_patterns: ["*.bib", "*.bst", "*.bibtex"],
		line_comments: ["%"],
	},
	"Bicep": {
		file_patterns: ["*.bicep", "*.bicepparam"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
	"Bison": {
		file_patterns: ["*.y", "*.yy", "*.bison"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		keywords: ["%token", "%type", "%start", "yyparse", "%define", "%code", "%require", "%language", "%skeleton", "%locations"],
	},
	"BitBake": {
		file_patterns: ["*.bb", "*.bbappend", "*.bbclass", "*.inc"],
		line_comments: ["#"],
		keywords: {words: ["DESCRIPTION", "SRC_URI", "do_compile", "do_install", "inherit", "DEPENDS", "RDEPENDS", "do_configure"], required: "shared"},
	},
	"Blade": {
		file_patterns: ["*.blade.php", "*.blade"],
		block_comments: [["{{--", "--}}"], ["<!--", "-->"]],
		embedding: "html",
	},
	"BlitzBasic": {
		file_patterns: ["*.bb", "*.decls", "*.bb2"],
		line_comments: [";"],
		keywords: ["Graphics", "Graphics3D", "Camera", "Mesh", "Repeat", "Until", "Forever"],
	},
	"BlitzMax": {
		file_patterns: ["*.bmx"],
		line_comments: ["'"],
		strings: ["\""],
	},
	"Blueprint": {
		file_patterns: ["*.blp"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		strings: ["\"", "'"],
	},
	"Bluespec": {
		file_patterns: ["*.bsv"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
	"Boo": {
		file_patterns: ["*.boo"],
		line_comments: ["#", "//"],
		block_comments: [["/*", "*/"]],
		nested_blocks: true,
	},
	"Boogie": {
		file_patterns: ["*.bpl"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		nested_blocks: true,
		strings: ["\""],
	},
	"Bosque": {
		file_patterns: ["*.bsq"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
	"BQN": {
		file_patterns: ["*.bqn"],
		line_comments: ["#"],
	},
	"Brainfuck": {
		file_patterns: ["*.bf", "*.b"],
		keywords: [">", "<", "+", "-", ".", ",", "[", "]"],
	},
	"BrightScript": {
		file_patterns: ["*.brs"],
		line_comments: ["'", "rem", "REM", "Rem"],
	},
	"BRLTTY Table": {
		file_patterns: ["*.atb", "*.ati", "*.ktb", "*.kti", "*.ttb", "*.tti"],
		line_comments: ["#"],
	},
	"Buck": {
		file_patterns: ["BUCK"],
		line_comments: ["#"],
	},
	"C": {
		file_patterns: ["*.c", "*.h", "*.ec", "*.pch", "*.pgc", "*.idc", "*.cats"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		keywords: {words: ["#include", "#define", "#ifndef", "#pragma", "int main", "void", "sizeof", "typedef", "struct", "extern", "#ifdef", "#endif", "static", "NULL", "unsigned"], case_sensitive: true},
		strings: ["\"", {open: "'", char: true}],
		line_splices: true,
	},
	"C Shell": {
		file_patterns: ["*.csh", ".cshrc", ".login"],
		line_comments: ["#"],
		shebangs: ["#!/bin/csh", "#!/usr/bin/env csh"],
		heredoc: "shell",
	},
	"C#": {
		file_patterns: ["*.cs", "*.csx", "*.cake", "*.cshtml.cs", "*.razor.cs", "*.linq", "*.cs.pp"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		strings: [
			"\"",
			{open: "'", char: true},
			{open: "@\"", close: "\"", escape: "\"", multiline: true},
			{open: "\"\"\"", escape: null, multiline: true},
			{open: "$\"", close: "\"", interpolation: "{"},
			{open: "$@\"", close: "\"", escape: "\"", multiline: true, interpolation: "{"},
			{open: "@$\"", close: "\"", escape: "\"", multiline: true, interpolation: "{"},
			{open: "$\"\"\"", close: "\"\"\"", escape: null, multiline: true, interpolation: "{"},
			// Its holes open with `{{`, which isn't followed; a single `{` is text.
			{open: "$$\"\"\"", close: "\"\"\"", escape: null, multiline: true},
		],
	},
	"C++": {
		file_patterns: ["*.cpp", "*.h", "*.hpp", "*.pch", "*.c++", "*.h++", "*.cc", "*.cxx", "*.hxx", "*.ino", "*.ipp", "*.cppm", "*.ixx", "*.c++m", "*.pcc", "*.tpp", "*.hh", "*.inl", "*.inc", "*.ccm", "*.cxxm", "*.mxx", "*.hppm", "*.hxxm", "*.tcc", "*.txx", "*.ii"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
		keywords: {words: ["#include", "#define", "#ifndef", "#ifdef", "#endif", "#pragma", "int main", "void", "sizeof", "typedef", "struct", "extern", "static", "NULL", "unsigned", "namespace", "template", "typename", "std::", "nullptr", "constexpr", "virtual", "operator", "public:", "protected:", "private:"], required: "shared", case_sensitive: true},
		strings: ["\"", {open: "'", char: true}, {open: "R\"", close: "\"", escape: null, multiline: true, delimited: true}],
		line_splices: true,
	},
	"C2": {
		file_patterns: ["*.c2"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"]],
	},
	"C3": {
		file_patterns: ["*.c3", "*.c3t", "*.c3i"],
		line_comments: ["//"],
		block_comments: [["/*", "*/"], ["<*", "*>"]],
		nested_blocks: true,
		// `[<` and `>]` bracket a vector's length (`int[<*>]`), which the compiler reads as one token, so the `<*` there isn't a comment.
		strings: ["\"", {open: "'", char: true}, {open: "`", escape: null, multiline: true}, {open: "[<", close: ">]", escape: null}],
	},
	"Cabal": {
		file_patterns: ["*.cabal", "cabal.project", "cabal.project.freeze", "cabal.config"],
		block_comments: [["{-", "-}"]],
		line_comments: ["--"],
	},
	"Caddyfile": {
		file_patterns: ["Caddyfile", "*.caddyfile"],
		line_comments: ["#"],
	},
	"Cadence": {
